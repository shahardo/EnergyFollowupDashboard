{
  "DemandScenario": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "preset": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "baseYear": {
        "type": "integer"
      },
      "horizonYear": {
        "type": "integer"
      },
      "sectors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "baseTWh": {
              "type": "number",
              "minimum": 0
            },
            "growthPct": {
              "type": "number"
            },
            "curve": {
              "type": "string",
              "enum": [
                "linear",
                "exp",
                "s"
              ]
            },
            "sMidYear": {
              "type": "integer"
            },
            "efficiencyPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "loadFactor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "nonElectric": {
              "type": "object",
              "properties": {
                "fuelsTWh": {
                  "type": "number",
                  "minimum": 0
                },
                "gasTWh": {
                  "type": "number",
                  "minimum": 0
                },
                "growthPct": {
                  "type": "number"
                },
                "electrifyOffset": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "fuelsTWh",
                "gasTWh",
                "growthPct"
              ],
              "additionalProperties": false
            },
            "subSectors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string"
                  },
                  "elecShare": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "fuelShare": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "growthPct": {
                    "type": "number"
                  }
                },
                "required": [
                  "key",
                  "label",
                  "elecShare",
                  "fuelShare"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "key",
            "label",
            "baseTWh",
            "growthPct",
            "curve",
            "efficiencyPct",
            "loadFactor"
          ],
          "additionalProperties": false
        }
      },
      "measures": {
        "type": "object",
        "properties": {
          "efficiencyPct": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          },
          "savingPct": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          }
        },
        "required": [
          "efficiencyPct",
          "savingPct"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "baseYear",
      "horizonYear",
      "sectors"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "SupplyScenario": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "preset": {
        "type": "string",
        "enum": [
          "reference",
          "declared",
          "tested"
        ]
      },
      "demandPreset": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "demandScenarioRef": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "renewable": {
              "type": "boolean"
            },
            "capacityGW": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "year": {
                    "type": "integer"
                  },
                  "gw": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "year",
                  "gw"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "capacityFactor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "capacityCredit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "retireYear": {
              "type": "integer"
            },
            "maxGW": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "key",
            "label",
            "enabled",
            "renewable",
            "capacityGW",
            "capacityFactor",
            "capacityCredit"
          ],
          "additionalProperties": false
        }
      },
      "fillPriority": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "planParams": {
        "type": "object",
        "properties": {
          "solar": {
            "type": "object",
            "properties": {
              "baseGW": {
                "type": "number",
                "minimum": 0
              },
              "slopeGW": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "baseGW",
              "slopeGW"
            ],
            "additionalProperties": false
          },
          "solar30": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "slopeGW": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "slopeGW"
            ],
            "additionalProperties": false
          },
          "solar40": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "slopeGW": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "slopeGW"
            ],
            "additionalProperties": false
          },
          "importElectricity": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "stepGW": {
                "type": "number",
                "minimum": 0
              },
              "stepYears": {
                "type": "integer",
                "minimum": 1
              },
              "steps": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start",
              "stepGW",
              "stepYears",
              "steps"
            ],
            "additionalProperties": false
          },
          "geothermal": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "rateGW": {
                "type": "number",
                "minimum": 0
              },
              "rampYears": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "rateGW",
              "rampYears"
            ],
            "additionalProperties": false
          },
          "fusion": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "rateGW": {
                "type": "number",
                "minimum": 0
              },
              "rampYears": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "rateGW",
              "rampYears"
            ],
            "additionalProperties": false
          },
          "cleanFuels": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "sharePct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "start",
              "sharePct"
            ],
            "additionalProperties": false
          },
          "hydrogen": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "sharePct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "start",
              "sharePct"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "solar",
          "solar30",
          "solar40",
          "importElectricity",
          "geothermal",
          "fusion",
          "cleanFuels",
          "hydrogen"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "sources",
      "fillPriority"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "ProjectsData": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "asOf": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "projects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string"
            },
            "mw": {
              "type": "number",
              "minimum": 0
            },
            "plannedStart": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "plannedEnd": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "progressPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "status": {
              "type": "string",
              "enum": [
                "on-track",
                "at-risk",
                "delayed"
              ]
            },
            "milestones": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "done": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "date",
                  "done"
                ],
                "additionalProperties": false
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "channel",
            "owner",
            "plannedStart",
            "plannedEnd",
            "progressPct",
            "milestones"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "asOf",
      "projects"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "TrilemmaScore": {
    "type": "object",
    "properties": {
      "security": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "affordability": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "sustainability": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "feasibilityPct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "required": [
      "security",
      "affordability",
      "sustainability",
      "feasibilityPct"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
